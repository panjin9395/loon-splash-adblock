#!name=开屏广告精简合集（闲鱼首版）
#!desc=v0.1.0；仅闲鱼开屏专用接口；非全覆盖；待手机验证。GPL-3.0；来源奶思/fmz200。
#!author=panjin9395；上游奶思/fmz200
#!homepage=https://github.com/panjin9395/loon-splash-adblock
#!date=2026-10-20
# License: GPL-3.0-only; see LICENSE and NOTICE.md
# Modified: keep only splash, narrow URL bounds, convert to Loon reject-dict.
[Rewrite]
^https://acs\.m\.goofish\.com/gw/mtop\.taobao\.idlecommerce\.splash\.ads/[0-9]+\.[0-9]+/(?:\?[^#\r\n]*)?$ reject-dict

[Mitm]
hostname = acs.m.goofish.com
