#!name=开屏广告精简合集
#!desc=v0.2.0；13款App候选开屏规则；非全覆盖；新增待手机验证。GPL-3.0；来源奶思/fmz200。
#!author=panjin9395；上游奶思/fmz200
#!homepage=https://github.com/panjin9395/loon-splash-adblock
#!date=2026-10-20
# License: GPL-3.0-only; see LICENSE and NOTICE.md
# Modified: keep only splash, narrow URL bounds, convert to Loon reject-dict.
[Rewrite]
^https://acs\.m\.goofish\.com/gw/mtop\.taobao\.idlecommerce\.splash\.ads/[0-9]+\.[0-9]+/(?:\?[^#\r\n]*)?$ reject-dict
^https://api\.pinduoduo\.com/api/cappuccino/splash(?:\?[^#\r\n]*)?$ reject
^https://api\.yangkeduo\.com/api/cappuccino/splash(?:\?[^#\r\n]*)?$ reject
^https://amap\-aos\-info\-nogw\.amap\.com/ws/aos/alimama/splash_screen_rt(?:\?[^#\r\n]*)?$ reject
^https://bootrealtime\.uve\.weibo\.com/v[0-9]/ad/realtime(?:\?[^#\r\n]*)?$ reject-dict
^https://bootpreload\.uve\.weibo\.com/v[0-9]/ad/preload(?:\?[^#\r\n]*)?$ reject-dict
^https://api\.zhihu\.com/commercial_api/launch_v2(?:\?[^#\r\n]*)?$ reject-dict
^https://api\.zhihu\.com/commercial_api/real_time_launch_v2(?:\?[^#\r\n]*)?$ reject-dict
^https://r\.inews\.qq\.com/getSplash(?:\?[^#\r\n]*)?$ reject
^https://mage\.if\.qidian\.com/argus/api/v[0-9]/client/getsplashscreen(?:\?[^#\r\n]*)?$ reject
^https://homefront\.qunar\.com/front/splash/ad(?:\?[^#\r\n]*)?$ reject-dict
^https://app\.dewu\.com/api/v1/app/advertisement(?:\?[^#\r\n]*)?$ reject
^https://api2\.yaduo\.com/atourlife/activity/appLaunch(?:\?[^#\r\n]*)?$ reject-dict
^https://api\.xiaoyuzhoufm\.com/v[0-9]/flash(?:\?[^#\r\n]*)?$ reject-dict
^https://appapi\.51job\.com/api/market/get_launch(?:\?[^#\r\n]*)?$ reject
^https://appapi\.51jobapp\.com/api/market/get_launch(?:\?[^#\r\n]*)?$ reject
^https://mapi\.dianping\.com/mapi/operating/loadsplashconfig(?:\?[^#\r\n]*)?$ reject

[Mitm]
hostname = acs.m.goofish.com, amap-aos-info-nogw.amap.com, api.pinduoduo.com, api.xiaoyuzhoufm.com, api.yangkeduo.com, api.zhihu.com, api2.yaduo.com, app.dewu.com, appapi.51job.com, appapi.51jobapp.com, bootpreload.uve.weibo.com, bootrealtime.uve.weibo.com, homefront.qunar.com, mage.if.qidian.com, mapi.dianping.com, r.inews.qq.com
